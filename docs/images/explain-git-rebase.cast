[14.527697, "o", "\u001b[?2026h\u001b[29A\r\u001b[0;36m⠧\u001b[2Cx\u001b[12C\u001b[0;2m4\u001b[1C0\u001b[5C410\r\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\u001b[4C·\r\r\n\u001b[2K\u001b[0m\u001b[?2026l"]
