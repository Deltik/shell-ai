[14.730506, "o", "\u001b[?2026h\u001b[29A\r\u001b[0;36m⠏\u001b[1CE\u001b[0;1;96mx\u001b[1C\u001b[0;36ml\u001b[12C\u001b[0;2m2\u001b[6C87\r\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\u001b[3C \r\r\n\u001b[2K\u001b[0m\u001b[?2026l"]
