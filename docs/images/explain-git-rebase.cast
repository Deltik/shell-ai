[15.034518, "o", "\u001b[A\u001b[2K\u001b[A\u001b[2K\u001b[A\u001b[2K\u001b[A\u001b[2K\u001b[A\u001b[2K\u001b[A\u001b[2K\u001b[A\u001b[2K\u001b[A\u001b[2K\u001b[A\u001b[2K\u001b[A\u001b[2K\u001b[A\u001b[2K\u001b[A\u001b[2K\u001b[A\u001b[2K\u001b[A\u001b[2K\u001b[A\u001b[2K\u001b[A\u001b[2K\u001b[A\u001b[2K\u001b[A\u001b[2K\u001b[A\u001b[2K\u001b[A\u001b[2K\u001b[A\u001b[2K\u001b[A\u001b[2K\u001b[A\u001b[2K\u001b[A\u001b[2K\u001b[A\u001b[2K\u001b[A\u001b[2K\u001b[A\u001b[2K\u001b[A\u001b[2K\u001b[A\u001b[2K"]
[15.034918, "o", "\r\n\u001b[1;37mExplanation:\u001b[0m\r\n\r\n  \u001b[2mRuns an interactive rebase with autosquash and autostash onto origin/main, and if successful, runs another rebase with autostash and matching committer dates to author dates onto the same upstream.\u001b[0m\r\n\r\n  • The first part of the command \u001b[36mgit rebase -i --autosquash --autostash origin/main\u001b[0m executes an interactive rebase with autosquash and autostash onto origin/main.\r\n    • \u001b[36mgit\u001b[0m invokes the Git version control system.\r\n    • \u001b[36mrebase\u001b[0m starts a rebase operation.\r\n    • \u001b[36m-i\u001b[0m requests an interactive rebase.\r\n    • \u001b[36m--autosquash\u001b[0m automatically squashes fixup and squash commits.\r\n    • \u001b[36m--autostash\u001b[0m automatically stashes and reapplies changes if needed.\r\n    • \u001b[36morigin/main\u001b[0m specifies the upstream branch to rebase onto.\r\n  • The two commands are separated by \u001b[36m&&\u001b[0m which runs the second only if the first succeeds."]
[15.034957, "o", "\r\n  • The second part of the command \u001b[36mgit rebase --autostash --committer-date-is-author-date origin/main\u001b[0m performs a rebase with autostash and sets the committer date to the author date onto origin/main.\r\n    • \u001b[36mgit\u001b[0m invokes the Git version control system.\r\n    • \u001b[36mrebase\u001b[0m starts a rebase operation.\r\n    • \u001b[36m--autostash\u001b[0m automatically stashes and reapplies changes if needed.\r\n    • \u001b[36m--committer-date-is-author-date\u001b[0m makes the committer date match the author date for each commit.\r\n    • \u001b[36morigin/main\u001b[0m specifies the upstream branch to rebase onto.\r\n\r\n"]
[15.036759, "o", "\u001b[?2004hdeltik@\u001b[1;34mandie2 \u001b[0;0m[~]$ "]
[16.455374, "o", "\u001b[?2004l\r\r\n"]
