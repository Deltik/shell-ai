[5.221745, "o", "\u001b[9A\u001b[J\u001b[1G"]
[7.129367, "o", "\"Rødgrød med fløde\" translates to **red berry pudding\r\n with cream**. \r\n\r\nHowever, it's famously difficult for non-\r\nDanish speakers to pronounce, and is often used as a bit of a\r\n linguistic challenge! There isn't a *perfect* equivalent in English cuisine\r\n. It's a sweet, thick berry pudding (usually made with a\r\n mix of red berries like strawberries, raspberries, and red currants) served with\r\n a dollop of cream.\r\n\r\n\r\n\r\n"]
[7.13295, "o", "\u001b[?2004hdeltik@\u001b[1;34mandie2 \u001b[0;0m[~]$ "]
