[1.840071, "o", "\u001b[?2026h\u001b[7A\r\u001b[22C\u001b[0;2m539\r\r\n\r\n\r\n\u001b[2K[2]\u001b[0m \u001b[0;32m✓\u001b[0m \u001b[0;2m(319 chars)\u001b[0m perl -e 'use Time::HiRes qw(sleep); my @colors=(31,33,32,36,34,35); my $cols=`tput cols`; chomp $cols; my $frames=300; for(my $f=0;$f<$frames;$f++){ my $line=\"\"; for(my $i=0;$i<$cols;$i++){ my $idx=int(($i+$f)*6/$cols)%6; $line.=\"\\e[1;\".$colors[$idx].\"m\\xe2\\x96\\x88\"; } print \"\\r$line\"; sleep(1/60); } print \"\\e[0m\\n\";'\u001b[K\r\r\n\u001b[2K\u001b[0;2m[3]\u001b[0m \u001b[0;32m✓\u001b[0m \u001b[0;2m(220 chars)\u001b[0m perl -e 'use Time::HiRes qw(sleep); my @c=(31,33,32,36,34,35); while (1) { for my $i (0..299) { print \"\\r\"; for my $j (0..79) { my $k=($i+$j)%6; print \"\\e[1;\".$c[$k].\"m\\xe2\\x96\\x88\"; } print \"\\e[0m\"; sleep(0.01667); } }'\u001b[K\r\r\n\u001b[0;2m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\r\n\u001b[0m\u001b[2K\u001b[?2026l"]
