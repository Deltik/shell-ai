[1.892636, "o", "\u001b[?2026h\u001b[A\u001b[2K\u001b[A\u001b[2K\u001b[A\u001b[2K\u001b[A\u001b[2K\u001b[A\u001b[2K\u001b[A\u001b[2K\u001b[A\u001b[2K\u001b[A\u001b[2K\u001b[A\u001b[2K\u001b[2K\u001b[?2026l\u001b[1G\u001b[J\u001b[1;37mSelect a command:\u001b[0m\r\n  \u001b[1;36m[1]\u001b[0m \u001b[1mperl -e 'use Time::HiRes qw(sleep); my @c=(31,33,32,36,34,35); while (1) { for my $i (0..299) { print \"\\r\"; for my $j (0..79) { my $k=($i+$j)%6; print \"\\e[1;\".$c[$k].\"m\\xe2\\x96\\x88\"; } print \"\\e[0m\"; sleep(0.01667); } }'\u001b[0m\r\n  \u001b[36m 2 \u001b[0m perl -e 'use Time::HiRes qw(sleep); my @colors=(31,33,32,36,34,35); my $cols=`tput cols`; chomp $cols; my $frames=300; for(my $f=0;$f<$frames;$f++){ my $line=\"\"; for(my $i=0;$i<$cols;$i++){ my $idx=int(($i+$f)*6/$cols)%6; $line.=\"\\e[1;\".$colors[$idx].\"m\\xe2\\x96\\x88\"; } print \"\\r$line\"; sleep(1/60); } print \"\\e[0m\\n\";'\r\n  \u001b[36m 3 \u001b[0m perl -e 'use Time::HiRes qw(sleep); my @colors=(31,33,32,36,34,35); my $cols=`tput cols`; chomp $cols; my $frames=300; my $speed=0.3; for(my $f=0;$f<$frames;$f++){ my $line=\"\"; for(my $i=0;$i<$cols;$i++){ my $wave=sin(($i/$cols)*6.28+$f*$speed)*0.5+0.5; my $idx=int($wave*6)%6; $line.=\"\\e[1m\\e[${colors[$idx]}m\\xe2\\x96\\x88\"; } print \"\\r$line\"; sleep(1/60); } print \"\\e[0m\\n\"'\r\n  \u001b[36m g \u001b[0m Generate new suggestions\r\n  \u001b[36m n \u001b[0m Enter a new command\r\n  \u001b[36m q \u001b[0m Quit\r\n\r\n\u001b[36m↑↓\u001b[0m\u001b[2m/\u001b[0m\u001b[36mjk\u001b[0m\u001b[2m navigate \u001b[0m\u001b[2m•\u001b[0m\u001b[2m \u001b[0m\u001b[36mkey\u001b[0m\u001b[2m/\u001b[0m\u001b[36mEnter\u001b[0m\u001b[2m select \u001b[0m\u001b[2m•\u001b[0m\u001b[2m \u001b[0m\u001b[36mEsc\u001b[0m\u001b[2m quit\u001b[0m\r\n"]
[2.793191, "o", "\u001b[15A\u001b[1G\u001b[J\u001b[1;37mSelect a command:\u001b[0m\r\n  \u001b[36m 1 \u001b[0m perl -e 'use Time::HiRes qw(sleep); my @c=(31,33,32,36,34,35); while (1) { for my $i (0..299) { print \"\\r\"; for my $j (0..79) { my $k=($i+$j)%6; print \"\\e[1;\".$c[$k].\"m\\xe2\\x96\\x88\"; } print \"\\e[0m\"; sleep(0.01667); } }'\r\n  \u001b[1;36m[2]\u001b[0m \u001b[1mperl -e 'use Time::HiRes qw(sleep); my @colors=(31,33,32,36,34,35); my $cols=`tput cols`; chomp $cols; my $frames=300; for(my $f=0;$f<$frames;$f++){ my $line=\"\"; for(my $i=0;$i<$cols;$i++){ my $idx=int(($i+$f)*6/$cols)%6; $line.=\"\\e[1;\".$colors[$idx].\"m\\xe2\\x96\\x88\"; } print \"\\r$line\"; sleep(1/60); } print \"\\e[0m\\n\";'\u001b[0m\r\n  \u001b[36m 3 \u001b[0m perl -e 'use Time::HiRes qw(sleep); my @colors=(31,33,32,36,34,35); my $cols=`tput cols`; chomp $cols; my $frames=300; my $speed=0.3; for(my $f=0;$f<$frames;$f++){ my $line=\"\"; for(my $i=0;$i<$cols;$i++){ my $wave=sin(($i/$cols)*6.28+$f*$speed)*0.5+0.5; my $idx=int($wave*6)%6; $line.=\"\\e[1m\\e[${colors[$idx]}m\\xe2\\x96\\x88\"; } print \"\\r$line\"; sleep(1/60); } print \"\\e[0m\\n\"'\r\n  \u001b[36m g \u001b[0m Generate new suggestions\r\n  \u001b[36m n \u001b[0m Enter a new command\r\n  \u001b[36m q \u001b[0m Quit\r\n\r\n\u001b[36m↑↓\u001b[0m\u001b[2m/\u001b[0m\u001b[36mjk\u001b[0m\u001b[2m navigate \u001b[0m\u001b[2m•\u001b[0m\u001b[2m \u001b[0m\u001b[36mkey\u001b[0m\u001b[2m/\u001b[0m\u001b[36mEnter\u001b[0m\u001b[2m select \u001b[0m\u001b[2m•\u001b[0m\u001b[2m \u001b[0m\u001b[36mEsc\u001b[0m\u001b[2m quit\u001b[0m\r\n"]
[3.727021, "o", "\u001b[15A\u001b[J\u001b[1G\r\nSelected: \u001b[32mperl -e 'use Time::HiRes qw(sleep); my @colors=(31,33,32,36,34,35); my $cols=`tput cols`; chomp $cols; my $frames=300; for(my $f=0;$f<$frames;$f++){ my $line=\"\"; for(my $i=0;$i<$cols;$i++){ my $idx=int(($i+$f)*6/$cols)%6; $line.=\"\\e[1;\".$colors[$idx].\"m\\xe2\\x96\\x88\"; } print \"\\r$line\"; sleep(1/60); } print \"\\e[0m\\n\";'\u001b[0m\r\n\u001b[1G\u001b[J\u001b[1;37mAction:\u001b[0m\r\n  \u001b[1;36m[c]\u001b[0m \u001b[1mCopy to clipboard\u001b[0m\r\n  \u001b[36m e \u001b[0m Explain command\r\n  \u001b[36m x \u001b[0m Execute command\r\n  \u001b[36m r \u001b[0m Revise command\r\n  \u001b[36m b \u001b[0m Back to suggestions\r\n  \u001b[36m q \u001b[0m Quit\r\n\r\n\u001b[36m↑↓\u001b[0m\u001b[2m/\u001b[0m\u001b[36mjk\u001b[0m\u001b[2m navigate \u001b[0m\u001b[2m•\u001b[0m\u001b[2m \u001b[0m\u001b[36mkey\u001b[0m\u001b[2m/\u001b[0m\u001b[36mEnter\u001b[0m\u001b[2m select \u001b[0m\u001b[2m•\u001b[0m\u001b[2m \u001b[0m\u001b[36mEsc\u001b[0m\u001b[2m quit\u001b[0m\r\n"]
